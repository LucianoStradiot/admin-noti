<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout">
    <Dialog title="{i18n>nuevo}" contentWidth="400px">
        <content>
            <f:SimpleForm id="oSimpleFormDisplayId" editable="false" layout="ResponsiveGridLayout" labelSpanXL="2" labelSpanL="2" labelSpanM="2" labelSpanS="2" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="2" singleContainerFullSize="false">
                <f:content>
                    <VBox>
                        <Label text="{i18n>FUNCTIONALITY}" required="true"/>
                        <Input id="inputFUNCTIONALITY" maxLength="100" width="100%" value="" required="true"/>
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12"/>
                        </layoutData>
                    </VBox>

                    <VBox>
                        <Label text="{i18n>SENDMAILFLAG}" required="true"/>
                        <Switch id="inputSENDMAILFLAG" type="AcceptReject" state="true">
                            <layoutData>
                                <FlexItemData growFactor="1" />
                            </layoutData>
                        </Switch>
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S6"/>
                        </layoutData>
                    </VBox>

                    <VBox>
                        <Label text="{i18n>SENDPORTALFLAG}" required="true"/>
                        <Switch id="inputSENDPORTALFLAG" type="AcceptReject" state="true">
                            <layoutData>
                                <FlexItemData growFactor="1" />
                            </layoutData>
                        </Switch>
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S6"/>
                        </layoutData>
                    </VBox>

                    <VBox>
                        <Label text="{i18n>SENDORIGIN}" required="true"/>
                        <Input id="inputSENDORIGIN" maxLength="10" width="100%" value="" required="false"/>
                        <layoutData>
							<l:GridData span="XL12 L12 M12 S12"/>
                        </layoutData>
                    </VBox>

                </f:content>
            </f:SimpleForm>
        </content>
        <buttons>
            <Button text="{i18n>guardar}" type="Emphasized" press="onDialogOk"/>
            <Button text="{i18n>cancelar}" press="dialogInsertarClose"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
