<core:FragmentDefinition xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<ViewSettingsDialog confirm="handleSortDialogConfirm" sortDescending="true" resetFilters="onResetSort">
		<sortItems>
			<ViewSettingsItem text="{i18n>ID}" key="ID"/>			
            <ViewSettingsItem text="{i18n>FUNCTIONALITY}" key="FUNCTIONALITY"/>
            <ViewSettingsItem text="{i18n>SENDMAILFLAG}" key="SENDMAILFLAG"/>
            <ViewSettingsItem text="{i18n>SENDPORTALFLAG}" key="SENDPORTALFLAG"/>
            <ViewSettingsItem text="{i18n>SENDORIGIN}" key="SENDORIGIN"/>
			<ViewSettingsItem text="{i18n>estado}" key="DELETESTATUS"/>			
		</sortItems>
	</ViewSettingsDialog>
</core:FragmentDefinition>